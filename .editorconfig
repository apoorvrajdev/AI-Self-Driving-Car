root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Baseline files are kept exactly as imported (CRLF, no normalisation).
[src/**]
end_of_line = crlf
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
